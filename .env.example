# 코쇠오피스 설정 — 이 파일을 .env 로 복사해 씁니다. (.env 는 Git에 올라가지 않습니다)

# AI 연결(처음 켤 때의 기본값. 화면 상단의 AI 표시를 눌러 실행 중에 바꿀 수 있습니다)
#   claude_cli(각자 Claude Code 구독, 기본) | openrouter | anthropic | openai_compat(사내 모델) | rule(규칙 기반만)
KOSOE_AI=claude_cli

# OpenRouter — 사내 GPU에 올릴 오픈 모델(DeepSeek 등)을 노트북 시연에서 대신 부를 때
# 키는 https://openrouter.ai/keys 에서 만들고 여기에만 적습니다(.env는 Git에 올라가지 않음). 요청 내용이 외부로 나가므로 가상 자료만 쓰세요.
KOSOE_OPENROUTER_API_KEY=
# 화면에서 고를 모델 목록(첫 번째가 기본). deepseek-v4.1-flash는 유료(소액)이고, :free 로 끝나는 모델은 무료(하루 요청 수 제한 · 붐빌 때 429)
# 무료 모델 목록은 자주 바뀝니다 — https://openrouter.ai/models?q=free 에서 확인해 바꾸세요
KOSOE_OPENROUTER_MODELS=deepseek/deepseek-v4.1-flash,nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,google/gemma-4-31b-it:free
# 추론 강도: off(가장 빠름) | low | medium | high | default
KOSOE_OPENROUTER_REASONING=low
# 작성용 · 가벼운 일(추천·채점·줄이기)용 모델 (claude_cli: sonnet | opus | haiku 별칭)
KOSOE_LLM_MODEL=sonnet
KOSOE_LLM_FAST_MODEL=haiku
KOSOE_LLM_EFFORT=low
# Claude CLI 경로 (비우면 데스크톱 앱 내장 최신 claude.exe → PATH 의 claude 순으로 찾음. 1.0.x는 쓰지 마세요)
KOSOE_CLAUDE_CLI=
# anthropic / openai_compat 일 때만
KOSOE_LLM_API_KEY=
KOSOE_LLM_BASE_URL=

# 폐쇄망 모드 AI: same(시연 — 같은 모델이 사내 LLM 자리) | rule
KOSOE_CLOSED_LLM=same
# 스킬 저장소(정본) — 전사 공용 스킬 잠금 파일과 부서·개인 스킬
KOSOE_SKILLS_REPO=humanist96/kosoe-office-skills
# PPT 엔진: ppt-master(전사 스킬) | lite(경량 대체)
KOSOE_PPT_ENGINE=ppt-master
# 데이터 폴더(기본 %USERPROFILE%\.kosoe) · 포트
KOSOE_HOME=
KOSOE_PORT=8810

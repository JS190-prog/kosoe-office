# 코쇠오피스 설정 — 이 파일을 .env 로 복사해 씁니다. (.env 는 Git에 올라가지 않습니다)

# AI 연결: claude_cli(각자 Claude Code 구독, 기본) | anthropic | openai_compat(사내 모델) | rule(규칙 기반만)
KOSOE_AI=claude_cli
# 작성용 · 가벼운 일(추천·채점·줄이기)용 모델 (claude_cli: sonnet | opus | haiku 별칭)
KOSOE_LLM_MODEL=sonnet
KOSOE_LLM_FAST_MODEL=haiku
KOSOE_LLM_EFFORT=low
# Claude CLI 경로 (비우면 데스크톱 앱 내장 최신 claude.exe → PATH 의 claude 순으로 찾음. 1.0.x는 쓰지 마세요)
KOSOE_CLAUDE_CLI=
# anthropic / openai_compat 일 때만
KOSOE_LLM_API_KEY=
KOSOE_LLM_BASE_URL=

# 폐쇄망 모드 AI: same(시연 — 같은 모델이 사내 LLM 자리) | rule
KOSOE_CLOSED_LLM=same
# 스킬 저장소(정본) — 전사 공용 스킬 잠금 파일과 부서·개인 스킬
KOSOE_SKILLS_REPO=humanist96/kosoe-office-skills
# PPT 엔진: ppt-master(전사 스킬) | lite(경량 대체)
KOSOE_PPT_ENGINE=ppt-master
# 데이터 폴더(기본 %USERPROFILE%\.kosoe) · 포트
KOSOE_HOME=
KOSOE_PORT=8810
